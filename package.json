{
  "name": "reperfil",
  "private": true,
  "version": "1.6.99",
  "type": "module",
  "description": "RePerfil — Orce, projete e reaproveite. Estoque de sobras e orçamento para esquadrias de alumínio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cobertura": "vitest run --coverage",
    "verificar": "npm run lint && npm run test && npm run build",
    "banco:consolidar": "node scripts/consolidar-banco.mjs",
    "banco:validar": "node scripts/validar-sql.mjs",
    "icones": "node scripts/gerar-icones.mjs",
    "versao:correcao": "node scripts/subir-versao.mjs correcao",
    "versao:etapa": "node scripts/subir-versao.mjs etapa",
    "versao:fase": "node scripts/subir-versao.mjs fase",
    "lighthouse": "vite build && vite preview --port 4173",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/android.mjs assembleDebug",
    "android:aab": "npm run android:sync && node scripts/android.mjs bundleRelease",
    "android:instalar": "npm run android:sync && node scripts/android.mjs installDebug",
    "android:estudio": "npm run android:sync && cap open android",
    "importar": "node scripts/importar-planilha.mjs",
    "secao:calcular": "node scripts/calcular-secao.mjs"
  },
  "dependencies": {
    "@bcyesil/capacitor-plugin-printer": "^0.0.6",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.95.0",
    "@tanstack/react-query": "^5.101.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.2.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "pg-query-emscripten": "^5.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.1.1",
    "xlsx": "^0.18.5"
  }
}
