# RePerfil — modelo de variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com os valores do SEU projeto.
# O arquivo `.env` está no .gitignore e NUNCA deve ser versionado.
#
# Onde encontrar: painel do Supabase → Project Settings → API

# URL do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública ("anon" / "publishable").
# É pública por design — quem protege os dados é o Row Level Security.
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon

# ATENÇÃO: a chave "service_role" ignora todas as políticas de segurança.
# Ela NUNCA deve ser colocada neste arquivo, em variável VITE_, nem em
# qualquer código que rode no navegador ou no aplicativo Android.
